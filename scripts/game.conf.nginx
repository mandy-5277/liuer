# 六儿 游戏服务器 Nginx 反代配置
# 用途：将 wss://liuer.xin/ws 反代到本机 node 游戏服务 (127.0.0.1:3000)
# 注意：微信小游戏真机要求 wss:// + 已备案域名；开发者工具可关校验用 ws://IP
#
# 启用步骤（域名已解析到本机 + 已完成 ICP 备案后）：
#   1. certbot certonly --nginx -d liuer.xin   (申请证书，certbot 会自动补 ssl 段)
#   2. 取消下方 443 server 块的注释
#   3. 取消 80 server 中 return 301 的注释（强制跳 https）
#   4. ln -sf /etc/nginx/sites-available/game.conf /etc/nginx/sites-enabled/  (若未链接)
#   5. nginx -t && systemctl reload nginx

# HTTP：仅用于 ACME 证书验证 + 临时访问；正式环境建议 301 跳 https
server {
    listen 80;
    server_name liuer.xin;

    # 证书申请期间的 ACME 挑战路径（certbot 自动管理，勿删）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 可选：HTTP 自动跳转 HTTPS（备案+证书就绪后打开）
    # return 301 https://$host$request_uri;

    # 健康检查 / 普通 HTTP 接口（可选保留）
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

