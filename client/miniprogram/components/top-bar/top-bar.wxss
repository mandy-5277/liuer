/* components/top-bar/top-bar.wxss */
.top-bar {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.top-logo {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.top-res {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.top-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.top-icon {
  font-size: 26rpx;
}

.top-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.top-cd {
  font-size: 22rpx;
  color: var(--color-text-light);
  font-weight: 400;
}
