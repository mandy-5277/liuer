/* components/settle-modal/settle-modal.wxss */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.settle-card {
  position: relative;
  width: 660rpx;
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
  border-radius: 24rpx;
  z-index: 1001;
}

.settle-title {
  font-size: 44rpx;
  font-weight: 800;
}

.settle-title.win { color: var(--color-gold); }
.settle-title.lose { color: var(--color-danger); }
.settle-title.draw { color: var(--color-text); }

.settle-subtitle {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.settle-score {
  font-size: 56rpx;
  font-weight: 900;
  margin-top: 16rpx;
}
.settle-score.win { color: var(--color-success); }
.settle-score.lose { color: var(--color-danger); }
.settle-score.draw { color: var(--color-text-secondary); font-size: 28rpx; font-weight: 400; }

/* 战绩详情 */
.settle-detail {
  margin-top: 24rpx;
  padding: 16rpx;
  background: rgba(60, 47, 40, 0.03);
  border-radius: 12rpx;
}

.detail-header {
  display: block;
  text-align: left;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.settle-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.settle-row-value {
  font-weight: 700;
}

/* 段位进度 */
.rank-progress {
  margin-top: 20rpx;
}

.rank-progress-header {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.rank-progress-track {
  width: 100%;
  height: 12rpx;
  background: #E8E3DA;
  border-radius: 6rpx;
  overflow: hidden;
}

.rank-progress-fill {
  height: 100%;
  background: var(--color-gold);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 按钮 */
.settle-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.btn-share {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  border: none;
  background: transparent;
  color: var(--color-primary);
  font-weight: 600;
  padding: 0;
}
.btn-share::after { border: none; }
