/* pages/rules/rules.wxss */
.rules-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 60rpx;
}

/* Tab 切换 */
.rules-tabs {
  display: flex;
  padding: 16rpx 16rpx;
  gap: 8rpx;
  background: var(--color-bg);
  position: sticky;
  top: 0;
  z-index: 10;
}

.rules-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  border-radius: 12rpx;
  background: transparent;
}

.rules-tab.active {
  background: var(--color-primary);
  color: white;
}

/* 内容卡 */
.rules-card {
  margin: 16rpx 24rpx;
  padding: 24rpx;
}

.rules-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
  margin-top: 24rpx;
}
.rules-section-title:first-child { margin-top: 0; }

.rules-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

/* 微型棋盘 */
.board-mini {
  display: flex;
  justify-content: center;
  margin: 24rpx 0;
}

.board-mini-grid {
  width: 240rpx;
  height: 240rpx;
  background: var(--color-board-bg);
  border-radius: 12rpx;
  border: 3rpx solid var(--color-board-line);
  position: relative;
}

.mini-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: var(--color-dot);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* 流程步骤 */
.rules-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.step {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: white;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.step-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 高亮提示 */
.rules-highlight {
  background: rgba(217, 74, 74, 0.08);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.rules-highlight-text {
  font-size: 26rpx;
  color: var(--color-danger);
  font-weight: 600;
}

/* 构型展示 */
.pattern-item {
  margin-bottom: 24rpx;
}

.pattern-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.pattern-demo {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pattern-grid-2x2 {
  display: grid;
  grid-template-columns: repeat(2, 48rpx);
  grid-template-rows: repeat(2, 48rpx);
  gap: 4rpx;
  padding: 12rpx;
  background: var(--color-board-bg);
  border-radius: 12rpx;
}

.pattern-grid-6x1 {
  display: grid;
  grid-template-columns: repeat(6, 32rpx);
  grid-template-rows: 32rpx;
  gap: 2rpx;
  padding: 10rpx;
  background: var(--color-board-bg);
  border-radius: 12rpx;
}

.pattern-piece {
  border-radius: 50%;
  width: 100%;
  height: 100%;
}

.pattern-piece.black {
  background: var(--color-piece-black);
}

.pattern-desc {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pattern-detail {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.pattern-effect {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 700;
}

/* 段位列表 */
.rank-rule-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rank-rule-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(60, 47, 40, 0.02);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.rank-rule-item.current {
  border-color: var(--color-primary);
  background: rgba(139, 105, 20, 0.06);
}

.rank-rule-icon {
  font-size: 36rpx;
}

.rank-rule-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.rank-rule-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.rank-rule-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 小贴士 */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  gap: 12rpx;
}

.tip-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-gold);
  color: white;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}
