<!-- pages/rules/rules.wxml - 规则说明 -->
<scroll-view class="rules-page" scroll-y>
  <!-- Tab 切换 -->
  <view class="rules-tabs">
    <view class="rules-tab {{tabIndex === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">基础规则</view>
    <view class="rules-tab {{tabIndex === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">构型详解</view>
    <view class="rules-tab {{tabIndex === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">积分段位</view>
    <view class="rules-tab {{tabIndex === 3 ? 'active' : ''}}" bindtap="switchTab" data-index="3">小提示</view>
  </view>

  <!-- Tab 0: 基础规则 -->
  <view class="card rules-card" wx:if="{{tabIndex === 0}}">
    <text class="rules-section-title">📐 棋盘规格</text>
    <view class="rules-text">
      <text>• 6×6 交叉点棋盘，共 36 个下子位</text>
      <text>• 棋子落在交叉点上（非方格内部）</text>
      <text>• 每方最多 18 颗棋子</text>
    </view>

    <view class="board-mini">
      <view class="board-mini-grid">
        <block wx:for="{{gridDots}}" wx:key="*this">
          <view class="mini-dot" style="left: {{item.x}}rpx; top: {{item.y}}rpx;"></view>
        </block>
      </view>
    </view>

    <text class="rules-section-title">🎮 对局流程</text>
    <view class="rules-steps">
      <view class="step">
        <view class="step-num">1</view>
        <view class="step-info">
          <text class="step-title">下子阶段</text>
          <text class="step-desc">双方轮流在交叉点放置棋子，每方最多 18 颗。此阶段不可揪子、不可走子。</text>
        </view>
      </view>
      <view class="step">
        <view class="step-num">2</view>
        <view class="step-info">
          <text class="step-title">揪子阶段</text>
          <text class="step-desc">棋子落满后，进入揪子阶段。每回合先揪子、再走子。揪子只能揪对方尚未成型的棋子。</text>
        </view>
      </view>
      <view class="step">
        <view class="step-num">3</view>
        <view class="step-info">
          <text class="step-title">走子阶段</text>
          <text class="step-desc">完成揪子后，选择一个己方棋子沿直线走一步（上下左右四向）。走到对方棋子相邻位置即为获胜。</text>
        </view>
      </view>
    </view>

    <text class="rules-section-title">🏁 胜负判定</text>
    <view class="rules-text">
      <text>• 己方棋子走到对方棋子相邻位置：胜利</text>
      <text>• 对方无可走棋子：胜利</text>
      <text>• 双方同意求和：和棋</text>
    </view>
  </view>

  <!-- Tab 1: 构型详解 -->
  <view class="card rules-card" wx:if="{{tabIndex === 1}}">
    <view class="rules-highlight">
      <text class="rules-highlight-text">仅此两种构型，无三连延展等其它构型</text>
    </view>

    <view class="pattern-item">
      <text class="pattern-title">🔲 方块 (2×2)</text>
      <view class="pattern-demo">
        <view class="pattern-grid-2x2">
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
        </view>
        <view class="pattern-desc">
          <text class="pattern-detail">条件：4 颗同色棋子组成 2×2 正方形</text>
          <text class="pattern-effect">效果：揪子 1 次</text>
        </view>
      </view>
    </view>

    <view class="pattern-item">
      <text class="pattern-title">▬ 六连</text>
      <view class="pattern-demo">
        <view class="pattern-grid-6x1">
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
          <view class="pattern-piece black"></view>
        </view>
        <view class="pattern-desc">
          <text class="pattern-detail">条件：同行或同列 6 颗同色棋子连成直线</text>
          <text class="pattern-effect">效果：揪子 2 次</text>
        </view>
      </view>
    </view>

    <view class="pattern-item">
      <text class="pattern-title">🔒 成型说明</text>
      <view class="rules-text">
        <text>• 组成方块(2×2)或六连的棋子即为"成型"棋子</text>
        <text>• 成型棋子不可被对方揪走，带有锁标 🔒</text>
        <text>• 优先选择让更多棋子成型，获得揪子优势</text>
      </view>
    </view>
  </view>

  <!-- Tab 2: 积分段位 -->
  <view class="card rules-card" wx:if="{{tabIndex === 2}}">
    <text class="rules-section-title">🏅 段位体系</text>
    <view class="rank-rule-list">
      <view class="rank-rule-item {{rankName === '初级小六' ? 'current' : ''}}">
        <text class="rank-rule-icon">🥉</text>
        <view class="rank-rule-info">
          <text class="rank-rule-name">初级小六</text>
          <text class="rank-rule-desc">入门段位 · 0~99 积分</text>
        </view>
      </view>
      <view class="rank-rule-item">
        <text class="rank-rule-icon">🥈</text>
        <view class="rank-rule-info">
          <text class="rank-rule-name">中级小六</text>
          <text class="rank-rule-desc">100~299 积分</text>
        </view>
      </view>
      <view class="rank-rule-item">
        <text class="rank-rule-icon">🥇</text>
        <view class="rank-rule-info">
          <text class="rank-rule-name">高级小六</text>
          <text class="rank-rule-desc">300~599 积分</text>
        </view>
      </view>
      <view class="rank-rule-item">
        <text class="rank-rule-icon">💎</text>
        <view class="rank-rule-info">
          <text class="rank-rule-name">初级老六</text>
          <text class="rank-rule-desc">600~899 积分</text>
        </view>
      </view>
      <view class="rank-rule-item">
        <text class="rank-rule-icon">💎</text>
        <view class="rank-rule-info">
          <text class="rank-rule-name">中级老六</text>
          <text class="rank-rule-desc">900~1299 积分</text>
        </view>
      </view>
      <view class="rank-rule-item">
        <text class="rank-rule-icon">💎</text>
        <view class="rank-rule-info">
          <text class="rank-rule-name">高级老六</text>
          <text class="rank-rule-desc">1300~1799 积分</text>
        </view>
      </view>
      <view class="rank-rule-item">
        <text class="rank-rule-icon">👑</text>
        <view class="rank-rule-info">
          <text class="rank-rule-name">资深老六</text>
          <text class="rank-rule-desc">1800+ 积分</text>
        </view>
      </view>
    </view>

    <text class="rules-section-title" style="margin-top:32rpx;">📊 积分规则</text>
    <view class="rules-text">
      <text>• 胜利：+3 积分（连胜追加 +1）</text>
      <text>• 失败：-3 积分</text>
      <text>• 和棋：双方各 -1 积分</text>
      <text>• 段位晋升后可获得铜板奖励</text>
    </view>
  </view>

  <!-- Tab 3: 小提示 -->
  <view class="card rules-card" wx:if="{{tabIndex === 3}}">
    <text class="rules-section-title">💡 策略小贴士</text>
    <view class="tips-list">
      <view class="tip-item">
        <text class="tip-num">1</text>
        <text class="tip-text">优先布局方块(2×2)构型，让更多棋子成型，获得揪子优势。</text>
      </view>
      <view class="tip-item">
        <text class="tip-num">2</text>
        <text class="tip-text">六连构型效果最强(揪子2次)，在条件允许时优先构建。</text>
      </view>
      <view class="tip-item">
        <text class="tip-num">3</text>
        <text class="tip-text">利用揪子打乱对手的构型布局，破坏对方成型。</text>
      </view>
      <view class="tip-item">
        <text class="tip-num">4</text>
        <text class="tip-text">走子阶段优先向对手棋子方向移动，逼近对手。</text>
      </view>
      <view class="tip-item">
        <text class="tip-num">5</text>
        <text class="tip-text">下子阶段前6手决定整盘棋局的走势，需要长远规划。</text>
      </view>
      <view class="tip-item">
        <text class="tip-num">6</text>
        <text class="tip-text">每颗棋子只能走一步，所以保持棋子的连通性非常关键。</text>
      </view>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</scroll-view>
