/* pages/profile/profile.wxss */
.profile-content {
  padding: 0 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 头像区域 */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 24rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-border);
  margin-bottom: 16rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.profile-rank-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  padding: 6rpx 20rpx;
  background: rgba(139, 105, 20, 0.08);
  border-radius: 100rpx;
}

.rank-icon {
  font-size: 28rpx;
}

/* 段位进度 */
.rank-section {
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.rank-progress {
  margin-bottom: 24rpx;
}

.rank-progress-header {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.rank-progress-track {
  width: 100%;
  height: 12rpx;
  background: #E8E3DA;
  border-radius: 6rpx;
  overflow: hidden;
}

.rank-progress-fill {
  height: 100%;
  background: var(--color-gold);
  border-radius: 6rpx;
}

/* 段位列表 */
.rank-list {
  border-top: 2rpx solid var(--color-border);
}

.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border-bottom: 2rpx solid var(--color-border);
}

.rank-item.last {
  border-bottom: none;
}

.rank-item.current {
  color: var(--color-primary);
  font-weight: 700;
}

/* 战绩统计 */
.stats-section {
  padding: 24rpx;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
}

.stat-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: rgba(60, 47, 40, 0.03);
  border-radius: 16rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
}

.stat-num.win { color: var(--color-success); }
.stat-num.lose { color: var(--color-danger); }

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* 资源 */
.resource-section {
  padding: 24rpx;
}

.resource-row {
  display: flex;
  gap: 24rpx;
}

.resource-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(139, 105, 20, 0.05);
  border-radius: 16rpx;
}

.resource-icon {
  font-size: 40rpx;
}

.resource-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.resource-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.resource-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 菜单 */
.menu-section {
  padding: 12rpx 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
}

.menu-arrow {
  font-size: 24rpx;
  color: var(--color-text-light);
}
